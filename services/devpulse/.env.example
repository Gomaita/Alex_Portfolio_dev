# Generate a local password before Compose: openssl rand -hex 24 (or Python secrets).
# URL-safe password; never reuse in production. No default production credentials.
POSTGRES_PASSWORD=
DEVPULSE_ENVIRONMENT=development
DEVPULSE_DATABASE_URL=postgresql+psycopg://devpulse:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/devpulse
DEVPULSE_REDIS_URL=redis://127.0.0.1:6380/0
DEVPULSE_FRONTEND_ORIGIN=http://127.0.0.1:5173
DEVPULSE_API_ORIGIN=http://127.0.0.1:8000
# Register authorization-code client with PKCE S256 and RS256 ID tokens.
# Callback: http://127.0.0.1:8000/api/v1/auth/callback
DEVPULSE_OIDC_ISSUER=
DEVPULSE_OIDC_CLIENT_ID=
# Optional for public PKCE clients; confidential clients use client_secret_basic.
DEVPULSE_OIDC_CLIENT_SECRET=
DEVPULSE_SESSION_HOURS=8
