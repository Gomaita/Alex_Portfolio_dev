{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/features/devpulse/**/*.ts",
    "src/features/devpulse/**/*.tsx"
  ],
  "exclude": ["src/features/devpulse/tests", "src/features/devpulse/e2e"]
}
